# Copy to .env and fill in. Never commit .env.

# SQLite database file path
SAVVY_SCOUT_DB_PATH=savvy_scout.db

# Sweep defaults
SAVVY_SCOUT_LOOKBACK_DAYS=7

# Find a Tender OCDS API (no auth required, public)
FIND_A_TENDER_BASE_URL=https://www.find-tender.service.gov.uk/api/1.0

# Contracts Finder API (no auth required, public)
CONTRACTS_FINDER_BASE_URL=https://www.contractsfinder.service.gov.uk/Published/Notices/OCDS/Search

# Phase B: AI scope reads (B2). Required for the "approve" action on the
# dashboard to run; the sweep/triage/export CLI commands work without it.
# Which provider is actually used is picked by SCOPE_READ_PROVIDER below --
# only that provider's key needs to be set.
ANTHROPIC_API_KEY=

# Alternate Phase 2 scope-read provider (2026-07-30), e.g. if Anthropic
# credit runs out. Set SCOPE_READ_PROVIDER=openai and fill this in instead
# of ANTHROPIC_API_KEY -- same assessment, same schema, different API.
OPENAI_API_KEY=
SCOPE_READ_PROVIDER=anthropic

# Phase B: Flask session signing key (B1). Generate with, e.g.,
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Account invite emails (2026-08-08, admin's "Manage Users" screen). Plain
# SMTP, not Microsoft Graph -- Graph needs the Azure AD app registration
# below, which was never completed. If these are unset, adding a user still
# works; the admin screen just shows the invite link + temp password on
# screen instead of emailing it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
NOTIFICATION_SENDER_EMAIL=

# Optional: the app's own public URL, put in invite emails. Falls back to
# the request's own host if unset (fine for a single-domain deploy).
SAVVY_SCOUT_APP_BASE_URL=

# Phase B/C: Microsoft Graph app registration (B3 escalation email, C2
# calendar, C3 Teams nudges). Not needed until you send an escalation email
# from the dashboard; the brief still generates as a .docx without these.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# The mailbox the escalation email is sent from (must be an @bidsavvy.io
# address with Mail.Send rights granted to the app registration above).
MS_GRAPH_SENDER_UPN=

# Auto-generated Weekly (Friday) and Monthly (1st) Trifork reports
# (SPEC.md C6). Must be an @bidsavvy.io address -- see notifications.py's
# send_email_with_attachment. If unset, the reports still generate to
# SAVVY_SCOUT_REPORTS_DIR but are not emailed.
REPORT_RECIPIENT_EMAIL=
SAVVY_SCOUT_REPORTS_DIR=reports

# Optional local Excel fallback for the supplied Trifork pipeline workbook.
# Use an absolute path when running Savvy Scout on the same Windows machine.
# Render cannot write to C:\Users\...; production cloud sync requires Graph.
TRIFORK_PIPELINE_OUTPUT_PATH=

# Competitor Intel company enrichment (2026-09-06): registered company
# name/number/address/status via Companies House's free public API. Free
# key, register at https://developer.company-information.service.gov.uk/.
# If unset, Competitor Intel works exactly as before, just without this.
COMPANIES_HOUSE_API_KEY=
